diff --git a/lib/ui/backup/drive_backup_screen.dart b/lib/ui/backup/drive_backup_screen.dart
new file mode 100644
index 0000000..4215221
--- /dev/null
+++ b/lib/ui/backup/drive_backup_screen.dart
@@ -0,0 +1,276 @@
+// CM Health v2.3.1 — Einstellungen „Sicherung nach Drive".
+//
+// Ordner wählen (Android-Dateidialog → Google-Drive-App), Sicherung ein/aus,
+// wöchentlicher Datenbank-Schnappschuss, Status der letzten Läufe, manuelles
+// Sichern und Nachholen der letzten 30 Tage. Logik: lib/backup/drive_backup.dart.
+
+import 'package:flutter/material.dart';
+import 'package:provider/provider.dart';
+
+import '../../backup/drive_backup.dart';
+import '../../state/app_state.dart';
+import '../../theme/theme.dart';
+import '../../theme/tokens.dart';
+import '../design/design.dart';
+import '../kit/kit.dart';
+
+class DriveBackupScreen extends StatelessWidget {
+  const DriveBackupScreen({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    final svc = context.read<AppState>().driveBackup;
+    return AppScaffold(
+      title: 'Sicherung nach Drive',
+      body: ListenableBuilder(
+        listenable: svc,
+        builder: (context, _) => _Body(svc: svc),
+      ),
+    );
+  }
+}
+
+class _Body extends StatelessWidget {
+  final DriveBackupService svc;
+  const _Body({required this.svc});
+
+  static String _fmt(DateTime? d) {
+    if (d == null) return 'noch nie';
+    String two(int v) => v.toString().padLeft(2, '0');
+    return '${two(d.day)}.${two(d.month)}.${d.year} ${two(d.hour)}:${two(d.minute)}';
+  }
+
+  Future<void> _pick(BuildContext context) async {
+    final ok = await svc.pickFolder();
+    if (!context.mounted) return;
+    if (ok) {
+      ScaffoldMessenger.of(context).showSnackBar(
+        SnackBar(content: Text('Ordner gesetzt: ${svc.folder?.label ?? ''}')),
+      );
+    }
+  }
+
+  Future<void> _runNow(BuildContext context, {bool snapshot = false}) async {
+    final ok = await svc.runNow(withSnapshot: snapshot);
+    if (!context.mounted) return;
+    ScaffoldMessenger.of(context).showSnackBar(
+      SnackBar(
+        content: Text(ok
+            ? 'Sicherung erledigt: ${svc.lastSummary}'
+            : 'Sicherung fehlgeschlagen: ${svc.lastError}'),
+      ),
+    );
+  }
+
+  Future<void> _backfill(BuildContext context) async {
+    final ok = await svc.backfill(30);
+    if (!context.mounted) return;
+    ScaffoldMessenger.of(context).showSnackBar(
+      SnackBar(
+        content: Text(ok
+            ? 'Nachholen erledigt: ${svc.lastSummary}'
+            : 'Nachholen fehlgeschlagen: ${svc.lastError}'),
+      ),
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final folder = svc.folder;
+    final busy = svc.busy;
+    final hasFolder = folder != null;
+    return ListView(
+      padding: EdgeInsets.fromLTRB(
+          Sp.screen, Sp.x2, Sp.screen, dsBottomGutter(context)),
+      children: [
+        Text('Zielordner', style: AppText.title),
+        const SizedBox(height: Sp.x2),
+        SurfaceCard(
+          padding: const EdgeInsets.all(Sp.x4),
+          onTap: busy ? null : () => _pick(context),
+          child: Row(
+            children: [
+              AppIcon(OsIcon.server, size: 22),
+              const SizedBox(width: Sp.x3),
+              Expanded(
+                child: Column(
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    Text(hasFolder ? 'Ordner' : 'Kein Ordner gewählt',
+                        style: AppText.captionMuted),
+                    const SizedBox(height: 2),
+                    Text(
+                      folder?.label ?? 'Antippen und Ordner wählen',
+                      style: AppText.title,
+                    ),
+                  ],
+                ),
+              ),
+              Text(hasFolder ? 'Ändern' : 'Wählen',
+                  style: AppText.captionMuted),
+            ],
+          ),
+        ),
+        const SizedBox(height: Sp.x2),
+        Text(
+          'Im Dateidialog links „Drive" (Google Drive) antippen, einen Ordner '
+          'öffnen oder anlegen und unten „Zugriff erlauben" bestätigen. Die App '
+          'darf danach nur in diesen einen Ordner schreiben; den Upload in die '
+          'Cloud übernimmt die Drive-App.',
+          style: AppText.captionMuted,
+        ),
+        const SizedBox(height: Sp.x4),
+        Text('Sicherung', style: AppText.title),
+        const SizedBox(height: Sp.x2),
+        SurfaceCard(
+          padding:
+              const EdgeInsets.symmetric(horizontal: Sp.x4, vertical: Sp.x2),
+          child: Column(
+            children: [
+              _switch(
+                'Automatisch sichern',
+                'Nachts ab 2 Uhr (auch über Mobilfunk): Herzreport-PDF, '
+                    'Puls-CSV und RR-CSV des Vortags, ca. 5 MB. Versäumte '
+                    'Nächte werden beim nächsten Lauf nachgeholt.',
+                svc.enabled,
+                hasFolder && !busy ? (v) => svc.setEnabled(v) : null,
+              ),
+              Divider(height: Sp.x3, thickness: 1, color: AppColors.divider),
+              _switch(
+                'Wöchentlich Datenbank-Schnappschuss',
+                'Komplette Datenbank komprimiert (.db.gz, je nach Größe '
+                    '50–150 MB); die letzten ${DriveBackupService.keepSnapshots} '
+                    'bleiben im Ordner. Wiederherstellen über „Daten importieren".',
+                svc.weeklyDb,
+                hasFolder && !busy ? (v) => svc.setWeeklyDb(v) : null,
+              ),
+            ],
+          ),
+        ),
+        const SizedBox(height: Sp.x4),
+        Text('Status', style: AppText.title),
+        const SizedBox(height: Sp.x2),
+        SurfaceCard(
+          padding: const EdgeInsets.all(Sp.x4),
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              if (busy) ...[
+                Row(
+                  children: [
+                    const SizedBox(
+                      width: 16,
+                      height: 16,
+                      child: CircularProgressIndicator(strokeWidth: 2),
+                    ),
+                    const SizedBox(width: Sp.x3),
+                    Expanded(
+                        child: Text(svc.progress.isEmpty ? 'Läuft …' : svc.progress,
+                            style: AppText.body)),
+                  ],
+                ),
+                const SizedBox(height: Sp.x2),
+              ],
+              _kv('Letzter Erfolg', _fmt(svc.lastOkAt)),
+              if (svc.lastSummary.isNotEmpty) _kv('Zuletzt', svc.lastSummary),
+              _kv('Letzter Schnappschuss', _fmt(svc.lastSnapshotAt)),
+              _kv('Gesicherte Tage', '${svc.doneDays.length}'),
+              if (svc.lastError.isNotEmpty)
+                Padding(
+                  padding: const EdgeInsets.only(top: Sp.x2),
+                  child: Text(
+                    'Fehler (${_fmt(svc.lastErrorAt)}): ${svc.lastError}',
+                    style: AppText.body.copyWith(color: AppColors.critical),
+                  ),
+                ),
+            ],
+          ),
+        ),
+        const SizedBox(height: Sp.x4),
+        SizedBox(
+          width: double.infinity,
+          child: FilledButton.icon(
+            onPressed: hasFolder && !busy ? () => _runNow(context) : null,
+            icon: AppIcon(OsIcon.sync, size: 18),
+            label: const Text('Jetzt sichern (Vortag)'),
+            style: FilledButton.styleFrom(
+              padding: const EdgeInsets.symmetric(vertical: Sp.x3),
+            ),
+          ),
+        ),
+        const SizedBox(height: Sp.x2),
+        SizedBox(
+          width: double.infinity,
+          child: OutlinedButton(
+            onPressed: hasFolder && !busy ? () => _backfill(context) : null,
+            style: OutlinedButton.styleFrom(
+              padding: const EdgeInsets.symmetric(vertical: Sp.x3),
+            ),
+            child: const Text('Letzte 30 Tage nachholen'),
+          ),
+        ),
+        const SizedBox(height: Sp.x2),
+        SizedBox(
+          width: double.infinity,
+          child: OutlinedButton(
+            onPressed: hasFolder && !busy
+                ? () => _runNow(context, snapshot: true)
+                : null,
+            style: OutlinedButton.styleFrom(
+              padding: const EdgeInsets.symmetric(vertical: Sp.x3),
+            ),
+            child: const Text('Datenbank-Schnappschuss jetzt'),
+          ),
+        ),
+        if (hasFolder) ...[
+          const SizedBox(height: Sp.x4),
+          TextButton(
+            onPressed: busy ? null : () => svc.releaseFolder(),
+            child: Text('Ordner-Zugriff aufheben',
+                style: AppText.body.copyWith(color: AppColors.critical)),
+          ),
+        ],
+        const SizedBox(height: Sp.x4),
+        Text(
+          'Die Sicherung läuft in der App selbst (kein Hintergrund-Job des '
+          'Systems): solange die App mit dem Band verbunden ist, prüft sie alle '
+          '15 Minuten, ob der Vortag gesichert ist. Dateien gleichen Namens '
+          'werden überschrieben, daher bleibt der Ordner sauber.',
+          style: AppText.captionMuted,
+        ),
+      ],
+    );
+  }
+
+  Widget _switch(
+      String title, String sub, bool value, ValueChanged<bool>? onChanged) {
+    return Row(
+      children: [
+        Expanded(
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              Text(title, style: AppText.body),
+              const SizedBox(height: 2),
+              Text(sub, style: AppText.captionMuted),
+            ],
+          ),
+        ),
+        Switch(value: value, onChanged: onChanged),
+      ],
+    );
+  }
+
+  Widget _kv(String k, String v) {
+    return Padding(
+      padding: const EdgeInsets.symmetric(vertical: 3),
+      child: Row(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          SizedBox(width: 130, child: Text(k, style: AppText.captionMuted)),
+          Expanded(child: Text(v, style: AppText.body)),
+        ],
+      ),
+    );
+  }
+}
