+/// CM Health v2.3.0: Abruftakt der Band-Daten (5/10/15 min). Das Band puffert
+/// im Flash; die App holt in diesem Takt nach. 5 min = schnellste Aktualität,
+/// kostet etwas Funkzeit (je Abruf ~30 s).
+class _SyncIntervalRow extends StatefulWidget {
+  const _SyncIntervalRow();
+
+  @override
+  State<_SyncIntervalRow> createState() => _SyncIntervalRowState();
+}
+
+class _SyncIntervalRowState extends State<_SyncIntervalRow> {
+  static const _options = [5, 10, 15];
+
+  @override
+  Widget build(BuildContext context) {
+    final app = context.read<AppState>();
+    final idx = _options.indexOf(app.syncIntervalMin).clamp(0, 2);
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.start,
+      children: [
+        Text('Abruftakt der Band-Daten', style: AppText.captionMuted),
+        const SizedBox(height: Sp.x2),
+        SegmentedControl(
+          options: const ['5 min', '10 min', '15 min'],
+          index: idx,
+          expanded: true,
+          onChanged: (i) async {
+            await app.setSyncIntervalMin(_options[i]);
+            if (mounted) setState(() {});
+          },
+        ),
+        const SizedBox(height: Sp.x2),
+        Text(
+          'Wie oft die App die im Band gepufferten Daten nachholt. '
+          '5 min hält „Heute" am aktuellsten und kostet etwas Funkzeit.',
+          style: AppText.captionMuted,
+        ),
+      ],
+    );
+  }
+}
+
+/// CM Health v2.3.0: Schalter „Ausführliches Protokoll". Aus = nur Zustands-,
+/// Fehler- und Weck-Zeilen (Log bleibt klein); An = zusätzlich jede
+/// Paket-Zeile des Sync-Protokolls (für tiefe Diagnosen, wächst schnell —
+/// Ringlog deckelt bei 50 MB).
+class _VerboseLogRow extends StatefulWidget {
+  const _VerboseLogRow();
+
+  @override
+  State<_VerboseLogRow> createState() => _VerboseLogRowState();
+}
+
+class _VerboseLogRowState extends State<_VerboseLogRow> {
+  @override
+  Widget build(BuildContext context) {
+    final app = context.read<AppState>();
+    return Row(
+      children: [
+        Expanded(
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              Text('Ausführliches Protokoll', style: AppText.body),
+              const SizedBox(height: 2),
+              Text(
+                'Paket-Ebene mitschreiben (nur für Diagnosen; Ringlog max. 50 MB).',
+                style: AppText.captionMuted,
+              ),
+            ],
+          ),
+        ),
+        Switch(
+          value: app.verboseLog,
+          onChanged: (v) async {
+            await app.setVerboseLog(v);
+            if (mounted) setState(() {});
+          },
+        ),
+      ],
+    );
+  }
+}
