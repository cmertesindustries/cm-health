+  /// CM Health v2.3.0: Einmalige Bereinigung von Geister-Tagen — alle Tage,
+  /// deren Datensätze vor [cutoffSec] liegen (Band-Uhr-Artefakte), samt
+  /// Rohdaten und abgeleiteten Zeilen. Liefert die Zahl gelöschter Zeilen.
+  static Future<int> cmPurgeBefore(int cutoffSec, String cutoffDay) async {
+    final db = await instance;
+    final days = <String>{};
+    for (final row in await db.rawQuery(
+      "SELECT DISTINCT date(rec_ts, 'unixepoch', 'localtime') AS d "
+      'FROM decoded_onehz WHERE rec_ts < ?',
+      [cutoffSec],
+    )) {
+      final d = row['d']?.toString();
+      if (d != null && d.isNotEmpty) days.add(d);
+    }
+    for (final t in const ['day_result', 'sleep_session_candidates',
+        'wake_day_features']) {
+      for (final row in await db.rawQuery(
+          'SELECT DISTINCT day_id AS d FROM $t WHERE day_id < ?', [cutoffDay])) {
+        final d = row['d']?.toString();
+        if (d != null && d.isNotEmpty) days.add(d);
+      }
+    }
+    for (final t in const ['derived_day', 'metric_series']) {
+      for (final row in await db.rawQuery(
+          'SELECT DISTINCT date AS d FROM $t WHERE date < ?', [cutoffDay])) {
+        final d = row['d']?.toString();
+        if (d != null && d.isNotEmpty) days.add(d);
+      }
+    }
+    int deleted = 0;
+    if (days.isNotEmpty) deleted += await deleteDays(days);
+    deleted += await db.delete('derived_day',
+        where: 'date < ?', whereArgs: [cutoffDay]);
+    deleted += await db.delete('decoded_rr',
+        where: 'counter IN (SELECT counter FROM decoded_onehz WHERE rec_ts < ?)',
+        whereArgs: [cutoffSec]);
+    deleted += await db.delete('decoded_onehz',
+        where: 'rec_ts < ?', whereArgs: [cutoffSec]);
+    deleted += await db.delete('samples',
+        where: 'ts < ?', whereArgs: [cutoffSec]);
+    deleted += await db.delete('raw_archive',
+        where: 'rec_ts IS NOT NULL AND rec_ts < ?', whereArgs: [cutoffSec]);
+    return deleted;
+  }
+
   static Future<int> deleteDays(Set<String> dayIds) async {
     final sorted = dayIds.toList()..sort();
     if (sorted.isEmpty) return 0;
