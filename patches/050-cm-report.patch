+// CM Health v2.3.0 — Herzreport exportieren.
+//
+// Tag wählen, Dateien ankreuzen (PDF-Bericht, 1-Hz-CSV, RR-CSV), erstellen,
+// teilen. Der Bericht wird komplett lokal aus der Datenbank gerechnet
+// (lib/report/heart_report.dart); nichts verlässt das Handy, außer man teilt.
+
+import 'package:flutter/material.dart';
+import 'package:share_plus/share_plus.dart';
+
+import '../../report/heart_report.dart';
+import '../../theme/theme.dart';
+import '../../theme/tokens.dart';
+import '../design/design.dart';
+import '../kit/kit.dart';
+
+class HeartReportScreen extends StatefulWidget {
+  const HeartReportScreen({super.key});
+
+  @override
+  State<HeartReportScreen> createState() => _HeartReportScreenState();
+}
+
+class _HeartReportScreenState extends State<HeartReportScreen> {
+  late DateTime _day;
+  bool _pdf = true;
+  bool _csvHr = true;
+  bool _csvRr = true;
+  bool _busy = false;
+  String _progress = '';
+  HeartReportStats? _last;
+  String? _error;
+
+  @override
+  void initState() {
+    super.initState();
+    final now = DateTime.now();
+    // Vor 12 Uhr ist der Vortag meist der interessantere (vollständige) Tag.
+    _day = now.hour < 12
+        ? DateTime(now.year, now.month, now.day - 1)
+        : DateTime(now.year, now.month, now.day);
+  }
+
+  String get _dayId => dayIdOf(_day);
+
+  static String dayIdOf(DateTime d) =>
+      '${d.year}-${d.month.toString().padLeft(2, '0')}-${d.day.toString().padLeft(2, '0')}';
+
+  Future<void> _pickDay() async {
+    final now = DateTime.now();
+    final picked = await showDatePicker(
+      context: context,
+      initialDate: _day,
+      firstDate: DateTime(2026, 8, 1),
+      lastDate: DateTime(now.year, now.month, now.day),
+      helpText: 'Tag für den Herzreport',
+    );
+    if (picked != null) {
+      setState(() {
+        _day = DateTime(picked.year, picked.month, picked.day);
+        _last = null;
+        _error = null;
+      });
+    }
+  }
+
+  Future<void> _run() async {
+    if (_busy || (!_pdf && !_csvHr && !_csvRr)) return;
+    final origin = shareOriginFor(context);
+    setState(() {
+      _busy = true;
+      _error = null;
+      _progress = 'Starte …';
+    });
+    try {
+      final files = await HeartReport.build(
+        dayId: _dayId,
+        pdf: _pdf,
+        csvHr: _csvHr,
+        csvRr: _csvRr,
+        progress: (p) {
+          if (mounted) setState(() => _progress = p);
+        },
+      );
+      final xfiles = <XFile>[
+        if (files.pdfPath != null) XFile(files.pdfPath!, mimeType: 'application/pdf'),
+        if (files.csvHrPath != null) XFile(files.csvHrPath!, mimeType: 'text/csv'),
+        if (files.csvRrPath != null) XFile(files.csvRrPath!, mimeType: 'text/csv'),
+      ];
+      if (mounted) {
+        setState(() {
+          _last = files.stats;
+          _progress = 'Fertig — Teilen-Dialog …';
+        });
+      }
+      await Share.shareXFiles(
+        xfiles,
+        text: 'CM Health Herzreport $_dayId',
+        sharePositionOrigin: origin,
+      );
+    } catch (e) {
+      if (mounted) setState(() => _error = '$e');
+    } finally {
+      if (mounted) {
+        setState(() {
+          _busy = false;
+          _progress = '';
+        });
+      }
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final s = _last;
+    final weekdays = const [
+      'Montag', 'Dienstag', 'Mittwoch', 'Donnerstag', 'Freitag', 'Samstag',
+      'Sonntag',
+    ];
+    final dayLabel = '${weekdays[_day.weekday - 1]}, '
+        '${_day.day.toString().padLeft(2, '0')}.'
+        '${_day.month.toString().padLeft(2, '0')}.${_day.year}';
+    return AppScaffold(
+      title: 'Herzreport',
+      body: ListView(
+        padding: EdgeInsets.fromLTRB(
+            Sp.screen, Sp.x2, Sp.screen, dsBottomGutter(context)),
+        children: [
+          SurfaceCard(
+            padding: const EdgeInsets.all(Sp.x4),
+            onTap: _busy ? null : _pickDay,
+            child: Row(
+              children: [
+                AppIcon(OsIcon.today, size: 22),
+                const SizedBox(width: Sp.x3),
+                Expanded(
+                  child: Column(
+                    crossAxisAlignment: CrossAxisAlignment.start,
+                    children: [
+                      Text('Tag', style: AppText.captionMuted),
+                      const SizedBox(height: 2),
+                      Text(dayLabel, style: AppText.title),
+                    ],
+                  ),
+                ),
+                Text('Ändern', style: AppText.captionMuted),
+              ],
+            ),
+          ),
+          const SizedBox(height: Sp.x3),
+          Text('Dateien', style: AppText.title),
+          const SizedBox(height: Sp.x2),
+          SurfaceCard(
+            padding: const EdgeInsets.symmetric(
+                horizontal: Sp.x4, vertical: Sp.x2),
+            child: Column(
+              children: [
+                _toggle(
+                  'PDF-Bericht',
+                  '2 Seiten: 24-h-Pulsband, Stundentabelle, Tachogramm, '
+                      'RR-Verteilung, Kennzahlen',
+                  _pdf,
+                  (v) => setState(() => _pdf = v),
+                ),
+                Divider(height: Sp.x3, thickness: 1, color: AppColors.divider),
+                _toggle(
+                  'Puls je Sekunde (CSV)',
+                  'epoch_s, zeit_lokal, puls_bpm — bis zu 86.400 Zeilen',
+                  _csvHr,
+                  (v) => setState(() => _csvHr = v),
+                ),
+                Divider(height: Sp.x3, thickness: 1, color: AppColors.divider),
+                _toggle(
+                  'Herzschläge RR (CSV)',
+                  'epoch_ms, zeit_lokal, rr_ms, momentan_bpm — jeder erfasste Schlag',
+                  _csvRr,
+                  (v) => setState(() => _csvRr = v),
+                ),
+              ],
+            ),
+          ),
+          const SizedBox(height: Sp.x4),
+          SizedBox(
+            width: double.infinity,
+            child: FilledButton.icon(
+              onPressed: _busy || (!_pdf && !_csvHr && !_csvRr) ? null : _run,
+              icon: _busy
+                  ? const SizedBox(
+                      width: 16,
+                      height: 16,
+                      child: CircularProgressIndicator(strokeWidth: 2),
+                    )
+                  : AppIcon(OsIcon.heartRate, size: 18),
+              label: Text(_busy ? _progress : 'Erstellen und teilen'),
+              style: FilledButton.styleFrom(
+                padding: const EdgeInsets.symmetric(vertical: Sp.x3),
+              ),
+            ),
+          ),
+          if (_error != null) ...[
+            const SizedBox(height: Sp.x3),
+            SurfaceCard(
+              padding: const EdgeInsets.all(Sp.x4),
+              child: Text(
+                _error!.replaceFirst('Bad state: ', ''),
+                style: AppText.body.copyWith(color: AppColors.critical),
+              ),
+            ),
+          ],
+          if (s != null) ...[
+            const SizedBox(height: Sp.x4),
+            Text('Zuletzt erstellt', style: AppText.title),
+            const SizedBox(height: Sp.x2),
+            SurfaceCard(
+              padding: const EdgeInsets.all(Sp.x4),
+              child: Column(
+                crossAxisAlignment: CrossAxisAlignment.start,
+                children: [
+                  _kv('Ø Puls',
+                      '${s.meanBpm.round()} bpm (Median ${s.medianBpm})'),
+                  _kv('Spanne', '${s.minBpm}–${s.maxBpm} bpm'),
+                  _kv('Abdeckung',
+                      '${(s.coverage * 100).toStringAsFixed(1)} % · ${s.samples} Messwerte'),
+                  _kv('Herzschläge', '${s.beats} (ab 2 s: ${s.longBeats})'),
+                  _kv(
+                      'Nacht-RMSSD',
+                      s.nightRmssd == null
+                          ? 'zu wenig Daten'
+                          : '${s.nightRmssd!.toStringAsFixed(1)} ms (00–05 Uhr)'),
+                ],
+              ),
+            ),
+          ],
+          const SizedBox(height: Sp.x4),
+          Text(
+            'Der Report wird komplett auf dem Handy aus den gespeicherten '
+            'Band-Daten gerechnet. Die Messung ist optisch (PPG) und kein EKG — '
+            'die Werte dienen der persönlichen Verlaufsbeobachtung, nicht der '
+            'Diagnose.',
+            style: AppText.captionMuted,
+          ),
+        ],
+      ),
+    );
+  }
+
+  Widget _toggle(
+      String title, String sub, bool value, ValueChanged<bool> onChanged) {
+    return Row(
+      children: [
+        Expanded(
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              Text(title, style: AppText.body),
+              const SizedBox(height: 2),
+              Text(sub, style: AppText.captionMuted),
+            ],
+          ),
+        ),
+        Switch(value: value, onChanged: _busy ? null : onChanged),
+      ],
+    );
+  }
+
+  Widget _kv(String k, String v) {
+    return Padding(
+      padding: const EdgeInsets.symmetric(vertical: 3),
+      child: Row(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          SizedBox(width: 110, child: Text(k, style: AppText.captionMuted)),
+          Expanded(child: Text(v, style: AppText.body)),
+        ],
+      ),
+    );
+  }
+}
