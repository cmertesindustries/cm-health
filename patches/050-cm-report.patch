+                    )
+                  : AppIcon(OsIcon.heartRate, size: 18),
+              label: Text(_busy ? _progress : 'Erstellen und teilen'),
+              style: FilledButton.styleFrom(
+                padding: const EdgeInsets.symmetric(vertical: Sp.x3),
+              ),
+            ),
+          ),
+          if (_error != null) ...[
+            const SizedBox(height: Sp.x3),
+            SurfaceCard(
+              padding: const EdgeInsets.all(Sp.x4),
+              child: Text(
+                _error!.replaceFirst('Bad state: ', ''),
+                style: AppText.body.copyWith(color: AppColors.critical),
+              ),
+            ),
+          ],
+          if (r != null) ...[
+            const SizedBox(height: Sp.x4),
+            Text('Zuletzt erstellt', style: AppText.title),
+            const SizedBox(height: Sp.x2),
+            SurfaceCard(
+              padding: const EdgeInsets.all(Sp.x4),
+              child: Column(
+                crossAxisAlignment: CrossAxisAlignment.start,
+                children: [
+                  _kv('Tage', '${r.days.length} mit Daten'
+                      '${r.missingDays.isEmpty ? '' : ', ${r.missingDays.length} ohne'}'),
+                  _kv('Dateien',
+                      '${r.pdfPath != null ? '1 PDF (${1 + 2 * r.days.length} Seiten)' : 'kein PDF'}'
+                      '${r.csvPaths.isEmpty ? '' : ', ${r.csvPaths.length} CSV'}'),
+                  if (r.days.isNotEmpty)
+                    _kv('Ø Puls',
+                        '${_rangeMean(r.days).round()} bpm über den Zeitraum'),
+                  if (r.missingDays.isNotEmpty)
+                    _kv('Keine Daten', r.missingDays.map(_shortId).join(', ')),
+                ],
+              ),
+            ),
+          ],
+          if (s != null && !_range) ...[
+            const SizedBox(height: Sp.x4),
+            Text('Zuletzt erstellt', style: AppText.title),
+            const SizedBox(height: Sp.x2),
+            SurfaceCard(
+              padding: const EdgeInsets.all(Sp.x4),
+              child: Column(
+                crossAxisAlignment: CrossAxisAlignment.start,
+                children: [
+                  _kv('Ø Puls',
+                      '${s.meanBpm.round()} bpm (Median ${s.medianBpm})'),
+                  _kv('Spanne', '${s.minBpm}–${s.maxBpm} bpm'),
+                  _kv('Abdeckung',
+                      '${(s.coverage * 100).toStringAsFixed(1)} % · ${s.samples} Messwerte'),
+                  _kv('Herzschläge', '${s.beats} (ab 2 s: ${s.longBeats})'),
+                  _kv(
+                      'Nacht-RMSSD',
+                      s.nightRmssd == null
+                          ? 'zu wenig Daten'
+                          : '${s.nightRmssd!.toStringAsFixed(1)} ms (00–05 Uhr)'),
+                ],
+              ),
+            ),
+          ],
+          const SizedBox(height: Sp.x4),
+          Text(
+            'Der Report wird komplett auf dem Handy aus den gespeicherten '
+            'Band-Daten gerechnet. Die Messung ist optisch (PPG) und kein EKG — '
+            'die Werte dienen der persönlichen Verlaufsbeobachtung, nicht der '
+            'Diagnose.',
+            style: AppText.captionMuted,
+          ),
+        ],
+      ),
+    );
+  }
+
+  static double _rangeMean(List<HeartReportStats> days) {
+    var n = 0;
+    var sum = 0.0;
+    for (final d in days) {
+      n += d.samples;
+      sum += d.meanBpm * d.samples;
+    }
+    return n == 0 ? 0 : sum / n;
+  }
+
+  static String _shortId(String dayId) {
+    final p = dayId.split('-');
+    return p.length == 3 ? '${p[2]}.${p[1]}.' : dayId;
+  }
+
+  Widget _toggle(
+      String title, String sub, bool value, ValueChanged<bool> onChanged) {
+    return Row(
+      children: [
+        Expanded(
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              Text(title, style: AppText.body),
+              const SizedBox(height: 2),
+              Text(sub, style: AppText.captionMuted),
+            ],
+          ),
+        ),
+        Switch(value: value, onChanged: _busy ? null : onChanged),
+      ],
+    );
+  }
+
+  Widget _kv(String k, String v) {
+    return Padding(
+      padding: const EdgeInsets.symmetric(vertical: 3),
+      child: Row(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          SizedBox(width: 110, child: Text(k, style: AppText.captionMuted)),
+          Expanded(child: Text(v, style: AppText.body)),
+        ],
+      ),
+    );
+  }
+}
