+     * (SYSTEM_ALERT_WINDOW); ohne sie zeigt bei gesperrtem Display weiterhin der
+     * Full-Screen-Intent das Overlay. Gibt zurück, ob der Start versucht wurde. */
+    private fun bringToFront(ctx: Context): Boolean {
+        return try {
+            val i = Intent(ctx, MainActivity::class.java).addFlags(
+                Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_REORDER_TO_FRONT
+            )
+            ctx.startActivity(i)
+            true
+        } catch (e: Exception) {
+            false
+        }
+    }
